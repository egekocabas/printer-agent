# Copy this file to .env, then replace values as needed.
# The mock backend runs without physical printer hardware.
PRINTER_BACKEND=mock

# To use a USB printer, change PRINTER_BACKEND to usb and set both IDs.
# Decimal and hexadecimal values such as 1155 and 0x0483 are accepted.
PRINTER_VENDOR_ID=
PRINTER_PRODUCT_ID=

# USB endpoint addresses. The python-escpos defaults are IN 0x82 and OUT 0x01.
# Inspect the device descriptors and override these when the printer differs.
PRINTER_IN_ENDPOINT=0x82
PRINTER_OUT_ENDPOINT=0x01

# Optional python-escpos printer profile. Leave empty if no compatible profile is known.
PRINTER_PROFILE=
PRINTER_DOTS_WIDTH=384
PRINTER_MODEL_NAME=ANJET58
PRINTER_IMAGE_BRIGHTNESS=1.25
PRINTER_IMAGE_CONTRAST=1.05
# Preview-only blur that simulates thermal dot spread. Set to 0 for raw printer dots.
PRINTER_PREVIEW_SMOOTHING_RADIUS=0.65
# 24-dot blank lines between an image and its optional date/time caption. Set to 0 to disable.
PRINTER_IMAGE_CAPTION_GAP_LINES=1
PRINTER_FINAL_FEED_LINES=5
# Optional override for image jobs. Empty means use PRINTER_FINAL_FEED_LINES.
PRINTER_IMAGE_FINAL_FEED_LINES=

# Input safety limits.
MAX_IMAGE_UPLOAD_BYTES=26214400
MAX_IMAGE_PIXELS=50000000
MAX_TEXT_CHARACTERS=10000
MAX_QR_CHARACTERS=4096
MAX_DOCUMENT_ITEMS=100
